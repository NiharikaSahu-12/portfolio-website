# -------------------------------------------------------------------
# EmailJS — powers the contact form.
# Copy this file to `.env` (git-ignored) and fill in the three values
# from https://dashboard.emailjs.com/admin
#
# If any value is missing the form does NOT fail silently: it opens the
# visitor's mail client with the message pre-filled instead.
# -------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
